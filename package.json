{
  "name": "wiring-design",
  "private": true,
  "version": "0.0.1",
  "description": "Plan the wiring of a robot or machine on its 3D model: place real parts, draw real cables from port to port, and check fit, bend and length across the joints' motion.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whk-irl/prototype-wiring-design.git"
  },
  "homepage": "https://github.com/whk-irl/prototype-wiring-design#readme",
  "bugs": {
    "url": "https://github.com/whk-irl/prototype-wiring-design/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.core.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "schema": "tsx tools/emit-schema.ts"
  },
  "dependencies": {
    "meshoptimizer": "^1.3.0",
    "occt-import-js": "^0.0.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.18",
    "urdf-loader": "^0.13.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.3",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "keywords": [
    "wiring",
    "cable",
    "harness",
    "robotics",
    "cad",
    "three.js",
    "routing",
    "prototype"
  ]
}
